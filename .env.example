# --- Lead delivery -----------------------------------------------------------
# Enquiries are always written to the D1 `leads` table first. The settings below
# add notification on top of that record.

# Resend (email notification). All three are required for email to be sent.
RESEND_API_KEY=
CONTACT_NOTIFICATION_TO=
CONTACT_NOTIFICATION_FROM=

# Optional extra sink: any HTTPS endpoint that accepts the validated enquiry JSON
# (CRM, Zapier, Make, n8n).
CONTACT_FORM_ENDPOINT=

# --- Measurement -------------------------------------------------------------
# The PostHog project key is committed in lib/analytics-config.ts (phc_ keys are
# publishable). Set these only to point a second environment at another project.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# GA4 is inert while this is empty.
GA_MEASUREMENT_ID=
